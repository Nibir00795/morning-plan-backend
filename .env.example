# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=morning_plan
POSTGRES_PASSWORD=morning_plan_secret
POSTGRES_DB=morning_plan

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Supabase Auth
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=morning-plan
# Public URL for uploaded files (e.g. https://api.example.com/storage). Leave empty to use MinIO direct URL.
STORAGE_PUBLIC_URL=

# RevenueCat
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret

# Push Notifications
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# App
NODE_ENV=development
PORT=3000

# Task limits
FREE_TASK_LIMIT=3
PREMIUM_TASK_LIMIT=50

# Favorite limits
FREE_FAVORITE_LIMIT=2
PREMIUM_FAVORITE_LIMIT=5

# Admin
ADMIN_API_KEY=change-this-to-a-secure-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
